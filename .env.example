RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RETELL_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Meta Pixel — find the ID in Meta Events Manager -> Data Sources -> your Pixel.
# Must be set in Vercel (Production + Preview + Development) and requires a
# fresh build, because NEXT_PUBLIC_* is inlined at build time.
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
